# Fixture for the config-parity check in the Dockerfile (stage `upstream-reference` and the RUN that diffs against it).
# Names follow what the Kubernetes deployment sets; values are placeholders. None of these is a real credential.
# JIGASI_INSTANCE_ID is set because the scripts otherwise randomise it, which would make the comparison differ.
JIGASI_INSTANCE_ID=parity-instance
XMPP_SERVER=xmpp.example.invalid
XMPP_PORT=5222
XMPP_DOMAIN=meet.example.invalid
XMPP_AUTH_DOMAIN=auth.meet.example.invalid
XMPP_GUEST_DOMAIN=guest.meet.example.invalid
XMPP_HIDDEN_DOMAIN=hidden.meet.example.invalid
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.example.invalid
XMPP_MUC_DOMAIN=muc.meet.example.invalid
XMPP_RECORDER_DOMAIN=recorder.meet.example.invalid
PUBLIC_URL=https://meet.example.invalid
ENABLE_AUTH=1
ENABLE_GUESTS=1
ENABLE_TRANSCRIPTIONS=1
JIGASI_BREWERY_MUC=jigasibrewery
JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=parity-fixture-xmpp
JIGASI_TRANSCRIBER_USER=transcriber
JIGASI_TRANSCRIBER_PASSWORD=parity-fixture-transcriber
JIGASI_TRANSCRIBER_CUSTOM_SERVICE=org.jitsi.jigasi.transcription.TranscribeService
JIGASI_TRANSCRIBER_ADVERTISE_URL=false
JIGASI_TRANSCRIBER_SEND_TXT=false
JIGASI_TRANSCRIBER_RECORD_AUDIO=false
JIGASI_SIP_URI=parity@sip.example.invalid
JIGASI_SIP_PASSWORD=parity-fixture-sip
JIGASI_SIP_SERVER=sip.example.invalid
JIGASI_SIP_PORT=5060
JIGASI_SIP_TRANSPORT=UDP
